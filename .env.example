# Inference provider (required for query execution)
GROQ_API_KEY=<GROQ_API_KEY>
GROQ_MODEL=llama-3.3-70b-versatile

# Vector store
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=agentic_rag_knowledge

# Pipeline tuning
RETRIEVAL_TOP_K=4
MAX_VERIFICATION_RETRIES=2
REASONING_TEMPERATURE=0.2
DETERMINISTIC_TEMPERATURE=0.0
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Guardrails
#   local      = built-in OSS-style scanners (default, no extra deps)
#   llm-guard  = ProtectAI llm-guard (pip install llm-guard)
#   bedrock    = AWS Bedrock Guardrails (pip install boto3 + AWS creds)
#   azure      = Azure AI Content Safety (pip install azure-ai-contentsafety)
#
# Open-source backends are ideal for local development. For multi-region
# production scale, prefer bedrock or azure managed policy services.
# ---------------------------------------------------------------------------
GUARDRAIL_BACKEND=local
GUARDRAIL_MAX_INPUT_CHARS=4000
GUARDRAIL_MAX_OUTPUT_CHARS=8000

# AWS Bedrock Guardrails (GUARDRAIL_BACKEND=bedrock)
# GUARDRAIL_BEDROCK_ID=<BEDROCK_GUARDRAIL_ID>
# GUARDRAIL_BEDROCK_VERSION=DRAFT
# AWS_REGION=us-east-1

# Azure AI Content Safety (GUARDRAIL_BACKEND=azure)
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_CONTENT_SAFETY_KEY=<AZURE_CONTENT_SAFETY_KEY>
